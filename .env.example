# Application Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://alumni.ktd.edu.vn
UPLOAD_DIR=/app/uploads

# PostgreSQL Database
POSTGRES_DB=alumni_ktd
POSTGRES_USER=alumni_ktd
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://alumni_ktd:CHANGE_ME_STRONG_DB_PASSWORD@alumni-ktd-db:5432/alumni_ktd

# Session Security (generate with >= 32 random bytes)
SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET

# Seeded Admin Accounts (set strong unique passwords in .env; never commit real secrets)
ADMIN1_EMAIL=admin@ktd.edu.vn
ADMIN1_PASSWORD=CHANGE_ME_ADMIN1_PASSWORD
ADMIN2_EMAIL=admin2@ktd.edu.vn
ADMIN2_PASSWORD=CHANGE_ME_ADMIN2_PASSWORD

# Optional Google Sign-In
# - Set GOOGLE_CLIENT_ID alone to enable Google Identity Services (ID Token RS256)
# - Also set GOOGLE_CLIENT_SECRET to enable server-side OAuth redirect fallback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Outbound SMTP (Microsoft 365 / Exchange Online for ktd.edu.vn)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=alumni@ktd.edu.vn
SMTP_PASS=
SMTP_FROM="Ban Điều hành Mạng lưới CSV KTD" <alumni@ktd.edu.vn>
